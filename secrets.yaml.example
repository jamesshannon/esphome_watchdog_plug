# Copy to secrets.yaml (gitignored) beside the config you build.
# Under the Home Assistant ESPHome add-on this file is /config/esphome/secrets.yaml
# and already exists; these are the four keys this project resolves.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
ota_password: "your-ota-password"
fallback_ap_password: "your-fallback-ap-password"
